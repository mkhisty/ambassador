{
  "name": "ambassador-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate.mjs",
    "files:migrate": "node --env-file-if-exists=.env.local scripts/migrate-files.mjs",
    "db:check": "node --env-file-if-exists=.env.local scripts/check-neon.mjs",
    "test:document-api": "node --env-file-if-exists=.env.local scripts/check-document-api.mjs",
    "db:setup-owner": "node --env-file-if-exists=.env.local scripts/setup-owner.mjs",
    "db:seed-demo": "node --env-file-if-exists=.env.local scripts/seed-demo.mjs",
    "demo:export": "node scripts/export-demo.mjs",
    "test": "node --test --test-isolation=none test/*.test.mjs"
  },
  "overrides": {
    "exceljs": { "uuid": "^11.1.1" }
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1146.0",
    "@neondatabase/serverless": "^1.2.0",
    "d3-sankey": "^0.12.3",
    "exceljs": "^4.4.0",
    "lucide-react": "^0.577.0",
    "next": "^16.3.8",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  }
}
