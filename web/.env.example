# Server-only pooled Neon Postgres connection string. Never use NEXT_PUBLIC_.
DATABASE_URL=
# Single organizer workspace access. Use at least 12 and 32 characters respectively.
WORKSPACE_PASSWORD=
# Separate account-registration invitation. Never reuse an account password.
WORKSPACE_INVITE_PASSWORD=
SESSION_SECRET=
# Optional server-to-server access for the Spectrum worker (at least 32 characters).
AGENT_API_TOKEN=

# Optional private Neon Object Storage bucket (S3-compatible).
# Without these, small documents are stored as bytea in Neon Postgres.
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
