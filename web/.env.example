# Server-only pooled Neon Postgres connection string. Never use NEXT_PUBLIC_.
DATABASE_URL=
# Single organizer workspace access. Use at least 12 and 32 characters respectively.
WORKSPACE_PASSWORD=
# Separate account-registration invitation. Never reuse an account password.
WORKSPACE_INVITE_PASSWORD=
SESSION_SECRET=
# Optional server-to-server access for the Spectrum worker (at least 32 characters).
AGENT_API_TOKEN=
# Optional server diagnostics; the listener's --verbose also enables worker-request diagnostics.
AMBASSADOR_VERBOSE=0

# Google OAuth server credentials. Keep private; configure the matching values in Vercel.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:3000/api/google/callback
# Base64-encoded 32 random bytes; encrypts per-user Google refresh tokens in Neon.
GOOGLE_TOKEN_ENCRYPTION_KEY=
# Gmail push notifications (same Google Cloud project as the OAuth client).
GMAIL_PUBSUB_TOPIC=projects/password-313816/topics/gmail-inbox
GMAIL_PUBSUB_SUBSCRIPTION=projects/password-313816/subscriptions/gmail-inbox-ambassador
GMAIL_PUSH_SERVICE_ACCOUNT=gmail-notifications@password-313816.iam.gserviceaccount.com
GMAIL_PUSH_AUDIENCE=https://ambassador-git-main-malhars-projects-3fcc794f.vercel.app/api/google/gmail/notifications

# Required private S3-compatible bucket for all live file uploads.
# Missing settings reject uploads; file bytes never fall back to Postgres.
AWS_ENDPOINT_URL_S3=
AWS_S3_BUCKET=
# Optional when exactly one bucket exists.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
