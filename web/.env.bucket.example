# Private Neon Object Storage connection (S3-compatible).
# Merge these entries into web/.env.local. Do not replace existing DATABASE_URL,
# WORKSPACE_PASSWORD, SESSION_SECRET, or AGENT_API_TOKEN values.
# Use the endpoint and credentials issued by Neon for the same project/branch.
# These are Neon storage credentials; a separate AWS account is not required.
# Never expose these variables with NEXT_PUBLIC_ or commit real credentials.

AWS_ENDPOINT_URL_S3=
AWS_S3_BUCKET=
# Optional when exactly one bucket exists; otherwise specify its name.
# Use the region shown in the bucket configuration.
AWS_REGION=us-east-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Restart the local app after filling web/.env.local.
# Set the same server-only variables in Vercel when deploying.
# Existing Postgres-backed documents remain accessible.
# Run npm run files:migrate to copy and verify them in the bucket before clearing DB bytes.
