# Public website origin; localhost HTTP is allowed for development.
AMBASSADOR_WEB_URL=http://127.0.0.1:3000
# Must match web/.env.local. If blank/omitted locally, the worker reads that file.
AGENT_API_TOKEN=
# Public HTTPS widget URL forwarded to port 8792.
WIDGET_PUBLIC_URL=
# Set to 1 for redacted request/provider diagnostics, or pass --verbose to listen.py.
AMBASSADOR_VERBOSE=0
# Process Gmail notifications using the website's saved inbox queue.
GMAIL_INBOX_ENABLED=1
# Required when AMBASSADOR_WEB_URL has Vercel deployment protection.
VERCEL_AUTOMATION_BYPASS_SECRET=
