# Local preview works without credentials. Copy to .env; never commit secrets.
SEND_MODE=preview
LEAD_SOURCE=mock
EVENT_FILE=demo/fixtures.json
DATA_DIR=data

# Spectrum Cloud: https://app.photon.codes
PROJECT_ID=
PROJECT_SECRET=
# Exact organizer sender IDs, separated by commas. Use E.164 phone numbers.
ORGANIZER_IDS=
# Optional sending line for projects with multiple dedicated iMessage lines.
IMESSAGE_LINE=

# AI drafting and natural-language requests; blank key uses labeled templates.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# SMTP email. Gmail supports smtp.gmail.com:465 with an app password when eligible.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=organizer@example.com
# For a live demo, redirect emails to an inbox YOU control. Shown before approval.
EMAIL_TEST_TO=

# Google Sheets: share the sheet with the service account's client_email.
# LEAD_SOURCE=sheets, then set these values. Credentials JSON stays in secrets/.
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB=Leads

# Notion: connect the integration to the database; use its DATA SOURCE id.
# LEAD_SOURCE=notion
NOTION_TOKEN=
NOTION_DATA_SOURCE_ID=
